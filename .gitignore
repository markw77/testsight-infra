# Plaintext secrets and local environment
.env
.env.*
!.env.example
*.vault-pass
vault-pass*
plain/
sealing-tmp/

# Kubernetes and SSH material
kubeconfig
kubeconfig-*
*.kubeconfig
*.key
*.pem

# Backups and dumps
*.dump
*.sql
*.sql.gz
*.dump.gz
*.sha256
backups/

# Ansible and Python
*.retry
.venv/
__pycache__/
*.pyc
.ansible/

# Host-specific values: LAN addressing stays local, the example stays tracked
ansible/host_vars/*/vars.yml
!ansible/host_vars/*/vars.yml.example
# deploy.sh keeps a timestamped copy before rewriting the address
ansible/host_vars/*/vars.yml.bak.*

# Per-cluster sealed manifests: regenerated by `make seal`, bound to one
# controller key, so nothing worth tracking. The directory itself is kept.
cluster-bootstrap/secrets/*.sealed.yaml


# Vault: ciphertext stays on the workstation, never in the repo
ansible/group_vars/all/vault.yml
