{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergePatch",
    ":automergeMinor",
    ":prHourlyLimit2"
  ],
  "labels": ["dependencies", "renovate"],
  "schedule": ["every weekend"],
  "timezone": "UTC",
  "prConcurrentLimit": 10,
  "branchConcurrentLimit": 5,
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group Ansible collection updates",
      "matchManagers": ["ansible-galaxy"],
      "groupName": "ansible-collections"
    },
    {
      "description": "Group pre-commit hook updates",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit-hooks"
    },
    {
      "description": "Group version pin and image updates from versions.env and Ansible vars",
      "matchManagers": ["custom.regex"],
      "groupName": "pinned-versions"
    },
    {
      "description": "Automerge patch/minor for GitHub Actions",
      "matchManagers": ["github-actions"],
      "automergeType": "pr",
      "automerge": true
    },
    {
      "description": "Automerge patch/minor for Ansible collections",
      "matchManagers": ["ansible-galaxy"],
      "automergeType": "pr",
      "automerge": true
    },
    {
      "description": "Automerge patch/minor for pre-commit hooks",
      "matchManagers": ["pre-commit"],
      "automergeType": "pr",
      "automerge": true
    },
    {
      "description": "Major updates need manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Argo CD is resolved from the Argo Helm chart repository",
      "matchDatasources": ["helm"],
      "registryUrls": ["https://argoproj.github.io/argo-helm"]
    }
  ],
  "github-actions": {"enabled": true},
  "ansible-galaxy": {"enabled": true},
  "pre-commit": {"enabled": true},
  "dockerfile": {"enabled": true},
  "kubernetes": {"enabled": true},
  "customManagers": [
    {
      "customType": "regex",
      "description": "k3s from versions.env",
      "managerFilePatterns": ["/cluster-bootstrap/versions\\.env$/"],
      "matchStrings": ["K3S_VERSION=(?<currentValue>v?[0-9.]+\\+k3s[0-9]+)"],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Helm from versions.env",
      "managerFilePatterns": ["/cluster-bootstrap/versions\\.env$/"],
      "matchStrings": ["HELM_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Argo CD Helm chart from versions.env",
      "managerFilePatterns": ["/cluster-bootstrap/versions\\.env$/"],
      "matchStrings": ["ARGOCD_CHART_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "argo-cd",
      "datasourceTemplate": "helm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Sealed Secrets controller from versions.env",
      "managerFilePatterns": ["/cluster-bootstrap/versions\\.env$/"],
      "matchStrings": ["SEALED_SECRETS_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "bitnami-labs/sealed-secrets",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "kubeseal from versions.env",
      "managerFilePatterns": ["/cluster-bootstrap/versions\\.env$/"],
      "matchStrings": ["KUBESEAL_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "bitnami-labs/sealed-secrets",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "kubeconform from versions.env",
      "managerFilePatterns": ["/cluster-bootstrap/versions\\.env$/"],
      "matchStrings": ["KUBECONFORM_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "yannh/kubeconform",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "kubectl from versions.env",
      "managerFilePatterns": ["/cluster-bootstrap/versions\\.env$/"],
      "matchStrings": ["KUBECTL_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "ansible-core from versions.env",
      "managerFilePatterns": ["/cluster-bootstrap/versions\\.env$/"],
      "matchStrings": ["ANSIBLE_CORE_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "ansible-core",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "postgres image from Ansible vars",
      "managerFilePatterns": ["/ansible/group_vars/all/vars\\.yml$/"],
      "matchStrings": ["postgres_image:\\s*\"?(?<depName>[^\"\\s:]+):(?<currentValue>[^\"\\s]+)\"?"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "pgadmin image from Ansible vars",
      "managerFilePatterns": ["/ansible/group_vars/all/vars\\.yml$/"],
      "matchStrings": ["pgadmin_image:\\s*\"?(?<depName>[^\"\\s:]+):(?<currentValue>[^\"\\s]+)\"?"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
