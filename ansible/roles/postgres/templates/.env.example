# Rendered by Ansible from Ansible Vault. Never edit or commit this file.
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}

PGADMIN_EMAIL={{ vault_pgadmin_email }}
PGADMIN_PASSWORD={{ vault_pgadmin_password }}

# The control plane uses this exact URL in its Sealed Secret. The password is
# URL-encoded by Ansible and must match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+asyncpg://{{ postgres_user }}:{{ vault_postgres_password | urlencode }}@{{ testsight_host_ip }}:5432/{{ postgres_db }}

# Backup settings (read by backup.sh).
BACKUP_DIR={{ backup_dir }}
BACKUP_RETENTION_DAYS={{ backup_retention_days }}
# Optional, e.g. "rclone copy \"$BACKUP_FILE\" remote:testsight-backups/".
OFFSITE_COPY_CMD=
